{
  "name": "@team/schematics",
  "version": "0.0.0",
  "description": "House-style schematics collection for nest g and nest new.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "schematics": "./dist/collection.json",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@angular-devkit/schematics": "^22.1.8",
    "@nestjs/schematics": "^12.0.4"
  },
  "devDependencies": {
    "@types/node": "24.13.6"
  }
}
