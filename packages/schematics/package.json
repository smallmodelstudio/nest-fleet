{
  "name": "@smallmodelstudio/schematics",
  "version": "0.1.0",
  "description": "House-style schematics collection for nest g and nest new.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smallmodelstudio/nest-fleet.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "schematics": "./dist/collection.json",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@angular-devkit/core": "^22.1.8",
    "@angular-devkit/schematics": "^22.1.8",
    "@nestjs/schematics": "^12.0.4",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "24.13.6"
  }
}
